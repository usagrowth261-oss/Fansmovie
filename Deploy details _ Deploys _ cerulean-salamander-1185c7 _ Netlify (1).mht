@keyframes rocket-launch { 
  0% { transform: translate(0px); }
  40% { transform: translate(150%, -150%); }
  41% { transform: translate(-150%, 150%); }
  100% { transform: translate(0px); }
}

.gear-icon svg { transform-origin: center center; transition: transform 0.3s ease-in-out; }

.gear-icon:hover svg { animation: 3s cubic-bezier(0.25, 1, 0.5, 1) 0s 1 normal none running gear-spin; }

@keyframes gear-spin { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

