.analytics-icon:hover svg { animation: 0.6s cubic-bezier(0.25, 1, 0.5, 1) 0s 1 normal both running bar-grow; }

@keyframes bar-grow { 
  0% { transform: scaleY(0); }
  100% { transform: scaleY(1); }
